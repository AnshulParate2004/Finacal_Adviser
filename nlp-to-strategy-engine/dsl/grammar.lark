// Trading Strategy DSL Grammar (Lark format) - Fixed

start: strategy // begins here

strategy: ENTRY ":" rule_block (EXIT ":" rule_block)? 
// Every strategy must have entry and exit is optional

rule_block: or_rule // Can contain AND, OR, comparisons, parentheses

or_rule: and_rule
       | or_rule OR and_rule -> bool_op
and_rule: comparison
        | and_rule AND comparison -> bool_op
// AND has higher priority than OR
// So this:
// A OR B AND C
// A OR (B AND C)
// so tree 
//       OR
//      /  \
//    A    AND
//         / \
//        C   D


comparison: expr comparison_op expr // smallest boolean unit left and right side expression 

expr: series // close, open, high, low, volume
    | indicator 
    | time_ref 
    | number 
    | series "*" number -> scale_series
    | number "*" series -> scale_series
    | "(" or_rule ")" // (close > open AND volume > 1000)

series: SERIES_LITERAL

indicator: INDICATOR_NAME "(" indicator_params ")"

indicator_params: SERIES_LITERAL "," number
                | SERIES_LITERAL "," number "," number
                | SERIES_LITERAL "," number "," number "," number

time_ref: SERIES_LITERAL "_" TIME_LAG
        | SERIES_LITERAL "[" number "]"
// Without TIME_LAG:
//ENTRY: close > high  # Wrong! Compares today's close to today's high
// With TIME_LAG:
//ENTRY: close crosses_above high_prev  # Correct! Compares today vs yesterday

number: NUMBER_SCALED

comparison_op: GT | LT | GTE | LTE | EQ | NEQ
             | CROSSES_ABOVE | CROSSES_BELOW | CROSSES | TOUCHES

// Terminals
INDICATOR_NAME: /sma|ema|rsi|macd|macd_signal|macd_histogram|bb_upper|bb_middle|bb_lower|atr|adx|stoch|stoch_d/i

SERIES_LITERAL: "close" | "open" | "high" | "low" | "volume" | "entry_price" | "price"

TIME_LAG: ("prev" | /\d+[dwm]_ago/)

NUMBER_SCALED: /-?\d+(\.\d+)?[KkMmBb]?/

GT: ">" // greater than
LT: "<" // less than
GTE: ">=" // greater than equal to
LTE: "<=" // less than equal to
EQ: "==" // equal to 
NEQ: "!=" // not equal to
CROSSES_ABOVE: "crosses_above"i
CROSSES_BELOW: "crosses_below"i
CROSSES: "crosses"i
TOUCHES: "touches"i

ENTRY: "ENTRY"i
EXIT: "EXIT"i
AND: "AND"i
OR: "OR"i

%import common.WS
%ignore WS
// **Effect:**
// - Parser automatically removes spaces, tabs, newlines
// - Your code doesn't need to handle whitespace manually